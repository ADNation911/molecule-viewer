# Local Ollama is the default and needs no API key.
MOLECULE3D_INFERENCE_PROVIDER=ollama
MOLECULE3D_CHAT_MODEL=qwen3:4b
MOLECULE3D_EMBED_MODEL=nomic-embed-text
OLLAMA_HOST=http://127.0.0.1:11434

# Public Render deployment uses Cloudflare Workers AI. Keep these values only
# in Render's secret environment, never in frontend variables or committed files.
# MOLECULE3D_INFERENCE_PROVIDER=cloudflare
# CLOUDFLARE_ACCOUNT_ID=your-account-id
# CLOUDFLARE_API_TOKEN=your-workers-ai-token
