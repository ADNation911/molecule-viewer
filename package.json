{
  "name": "molecule3d",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A molecular workbench for exploring structures in your browser.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "npm run test:frontend && npm run test:backend",
    "test:frontend": "node --test tests/*.test.js",
    "test:backend": "python -m unittest discover -s tests -p \"test_*.py\" -v",
    "test:rag": "npm run test:backend",
    "check": "npm test && npm run build"
  },
  "engines": { "node": ">=22.12.0" },
  "dependencies": { "3dmol": "2.5.5" },
  "devDependencies": { "vite": "8.3.0" }
}
